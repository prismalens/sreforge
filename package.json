{
  "name": "sreforge",
  "version": "0.0.2",
  "private": true,
  "description": "A running environment for testing prismalens: booklogr, Prometheus and Alertmanager in docker compose, with faults you switch on.",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test tools/rules-lint/test/*.test.mjs tools/rca-judge/test/*.test.mjs tools/dashboard/test/*.test.mjs",
    "rules-lint": "node tools/rules-lint/lint.mjs",
    "judge:rca": "node tools/rca-judge/judge.mjs"
  },
  "devDependencies": {
    "@go-task/cli": "^3.53.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@go-task/cli"
    ]
  }
}
