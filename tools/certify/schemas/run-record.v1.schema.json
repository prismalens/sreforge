{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sreforge.dev/schemas/run-record.v1.json",
  "title": "SREForge Run Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_version", "kind", "run_id", "scenario_id", "profile",
    "trigger", "trajectory", "diff", "ci", "deploy", "score",
    "verdict", "timings", "started_at", "finished_at"
  ],
  "properties": {
    "record_version": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$" },
    "kind": { "const": "run-record" },
    "run_id": { "type": "string" },
    "scenario_id": { "type": "string" },
    "profile": { "enum": ["incident", "patch"] },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "alert_name", "labels", "annotations", "fired_at"],
      "properties": {
        "source": { "type": "string" },
        "alert_name": { "type": "string" },
        "severity": { "type": "string" },
        "labels": { "type": "object" },
        "annotations": { "type": "object" },
        "fired_at": { "type": "string" },
        "kickoff_alert": { "type": "string" },
        "signals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["alert_name", "labels", "annotations", "fired_at"],
            "properties": {
              "alert_name": { "type": "string" },
              "severity": { "type": "string" },
              "labels": { "type": "object" },
              "annotations": { "type": "object" },
              "fired_at": { "type": "string" }
            }
          }
        }
      }
    },
    "trajectory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_name", "diff", "submitted", "duration_ms"],
      "properties": {
        "agent_name": { "type": "string" },
        "transcript": { "type": "string" },
        "diff": { "type": "string" },
        "submitted": { "type": "boolean" },
        "duration_ms": { "type": "number" }
      }
    },
    "diff": { "type": "string" },
    "ci": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["green", "output", "duration_ms"],
      "properties": {
        "green": { "type": "boolean" },
        "output": { "type": "string" },
        "exit_code": { "type": "number" },
        "duration_ms": { "type": "number" }
      }
    },
    "deploy": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["redeployed", "service", "duration_ms"],
      "properties": {
        "redeployed": { "type": "boolean" },
        "service": { "type": "string" },
        "duration_ms": { "type": "number" }
      }
    },
    "score": { "$ref": "#/$defs/oracle_score" },
    "verdict": { "enum": ["passed", "failed", "rejected", "aborted", "error"] },
    "timings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trigger": { "type": "number" },
        "context": { "type": "number" },
        "run": { "type": "number" },
        "ci": { "type": "number" },
        "merge": { "type": "number" },
        "redeploy": { "type": "number" },
        "verify": { "type": "number" },
        "record": { "type": "number" },
        "cleanup": { "type": "number" }
      }
    },
    "started_at": { "type": "string" },
    "finished_at": { "type": "string" },
    "agent_transcript": { "type": "object" },
    "full_record_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "oracle_signal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "satisfied", "value", "weight", "detail"],
      "properties": {
        "id": { "type": "string" },
        "satisfied": { "type": "boolean" },
        "value": { "type": "number" },
        "weight": { "type": "number" },
        "detail": { "type": "string" }
      }
    },
    "oracle_score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["oracle_id", "score", "passed", "signals"],
      "properties": {
        "oracle_id": { "type": "string" },
        "score": { "type": "number" },
        "passed": { "type": "boolean" },
        "signals": { "type": "array", "items": { "$ref": "#/$defs/oracle_signal" } },
        "sub_scores": { "type": "array", "items": { "$ref": "#/$defs/oracle_score" } }
      }
    }
  }
}
