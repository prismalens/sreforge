# Read by scripts/fault.sh. CHANGE_n is a .patch or a .sh run inside the booklogr checkout.
# The upstream's 5xx rate is the red herring; the cause is the cache commit.
ALERT=BooklogrApiLatencyP99High
STORM=booklogr-storm.js
RATE=25
RUNTIME_ENV="SEARCH_STUB_5XX_RATE=0.08"
CHANGE_1=inject/disable-cache.sh
MESSAGE_1="Disable response caching"
AUTHOR_1="Andreas Backström <mozzo242@gmail.com>"
DATE_1="2026-06-11 10:34:52 +0200"
